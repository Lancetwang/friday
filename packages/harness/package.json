{
  "name": "friday-agent-harness",
  "version": "0.9.2",
  "private": true,
  "type": "module",
  "bin": {
    "friday-gateway": "dist/gateway.js"
  },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./gateway": "./dist/gateway.js",
    "./plugin": {
      "types": "./dist/plugin-api.d.ts",
      "import": "./dist/plugin-api.js"
    }
  },
  "scripts": {
    "build": "node scripts/sync-prompts.mjs --check && tsc -p tsconfig.json",
    "check": "node scripts/sync-prompts.mjs --check && tsc --noEmit -p tsconfig.json",
    "gateway": "node dist/gateway.js",
    "prompts": "node scripts/sync-prompts.mjs",
    "test": "npm run build && node --test dist/*.test.js"
  },
  "dependencies": {
    "friday-agent-core": "0.9.2",
    "friday-agent-protocol": "0.9.2",
    "ignore": "7.0.6",
    "proper-lockfile": "^4.1.2"
  },
  "devDependencies": {
    "@types/proper-lockfile": "^4.1.4"
  }
}
