LLM_API_KEY=
TAVILY_API_KEY=
ANYSEARCH_API_KEY=
JINA_API_KEY=

# Phone bridge. Settings has a Phone section that saves these for you; set them
# here only to override what is saved, for example on a headless machine. Leave
# ALLOWED_USERS empty on a first run: the bridge then refuses every message and
# prints the open_id to allow.
FRIDAY_FEISHU_APP_ID=
FRIDAY_FEISHU_APP_SECRET=
FRIDAY_FEISHU_ALLOWED_USERS=
FRIDAY_FEISHU_ALLOW_GROUP=
